<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile | Serene Habit</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/profile.css" />
</head>

<body>
    <!-- ========== TOP NAV ========== -->
    <header class="top-nav">
        <div class="container nav-container">
            <h1 class="page-headline">Profile</h1>
            <button class="settings-btn">
                <span class="material-symbols-outlined">settings</span>
            </button>
        </div>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="container main-content">
        <!-- Profile Header -->
        <section class="profile-header">
            <div class="profile-greeting">
                <h2 class="greeting-title">Hello, <%= typeof user !=='undefined' && user ? user.name || 'User' : 'User'
                        %>!</h2>
                <p class="greeting-subtitle">Keep up the great work on your habits today.</p>
            </div>
            <p class="member-since">
                Member since
                <% let memberDate='January 2024' ; if (typeof user !=='undefined' && user && user.createdAt) { try {
                    memberDate=new Date(user.createdAt).toLocaleString('default', { month: 'long' , year: 'numeric' });
                    } catch(e) { memberDate='January 2024' ; } } %>
                    <%= memberDate %>
            </p>
        </section>

        <!-- Stats Bento Grid -->
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="material-symbols-outlined stat-icon">local_fire_department</span>
                    <p class="stat-label">Current Streak</p>
                    <p class="stat-value">
                        <%= typeof streak !=='undefined' && streak ? streak : 0 %> Days
                    </p>
                </div>
                <div class="stat-card">
                    <span class="material-symbols-outlined stat-icon">task_alt</span>
                    <p class="stat-label">Total Habits</p>
                    <p class="stat-value">
                        <%= typeof totalHabits !=='undefined' && totalHabits ? totalHabits : 0 %>
                    </p>
                </div>
                <div class="stat-card">
                    <span class="material-symbols-outlined stat-icon">trending_up</span>
                    <p class="stat-label">Completion</p>
                    <p class="stat-value">
                        <%= typeof completionRate !=='undefined' && completionRate ? completionRate : 0 %>%
                    </p>
                </div>
            </div>
        </section>

        <!-- Account Settings List -->
        <section class="settings-section">
            <h3 class="settings-title">Account Preferences</h3>
            <div class="settings-list">
                <button class="settings-item">
                    <div class="settings-item-left">
                        <span class="material-symbols-outlined settings-item-icon">notifications</span>
                        <span class="settings-item-text">Reminders</span>
                    </div>
                    <span class="material-symbols-outlined settings-item-arrow">chevron_right</span>
                </button>
                <div class="settings-divider"></div>
                <button class="settings-item">
                    <div class="settings-item-left">
                        <span class="material-symbols-outlined settings-item-icon">verified_user</span>
                        <span class="settings-item-text">Privacy & Security</span>
                    </div>
                    <span class="material-symbols-outlined settings-item-arrow">chevron_right</span>
                </button>
                <div class="settings-divider"></div>
                <button class="settings-item">
                    <div class="settings-item-left">
                        <span class="material-symbols-outlined settings-item-icon">help</span>
                        <span class="settings-item-text">Support Center</span>
                    </div>
                    <span class="material-symbols-outlined settings-item-arrow">chevron_right</span>
                </button>
            </div>
        </section>

        <!-- Logout Action -->
        <section class="logout-section">
            <form action="/logout" method="POST">
                <button class="logout-btn" type="submit">
                    <span class="material-symbols-outlined logout-icon">logout</span>
                    Logout
                </button>
            </form>
            <p class="version-text">Version 2.4.1 (Stable)</p>
        </section>
    </main>

    <!-- ========== BOTTOM NAV ========== -->
    <nav class="bottom-nav">
        <a class="nav-link" href="/">
            <span class="material-symbols-outlined">home</span>
            <span class="nav-label">Home</span>
        </a>
        <a class="nav-link" href="/habits">
            <span class="material-symbols-outlined">checklist</span>
            <span class="nav-label">Habits</span>
        </a>
        <a class="nav-link active" href="/profile">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">person</span>
            <span class="nav-label">Profile</span>
        </a>
    </nav>

    <!-- ========== SCRIPTS ========== -->
    <script>
        // Micro-interaction for hover effects on stat cards
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-2px)';
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'translateY(0px)';
            });
        });
    </script>
</body>

</html>